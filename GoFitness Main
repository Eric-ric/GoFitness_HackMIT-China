/// 商城中可兑换的一条奖励（标题 + 说明 + 所需积分）。
private struct ShopReward: Identifiable {
    let id: String // 唯一标识，写入 UserDefaults 表示已兑换
    let titleKey: LKey // 标题在 L10n 中的键
    let descKey: LKey // 描述文案键
