// MARK: - AI 助手
// 【模块说明】AI 教练 Tab：聊天气泡、请求本地 dashscope-proxy、打开训练日志、防刷与内容安全回调。

/// 本地后端 `dashscope-proxy`：默认模拟器用 127.0.0.1；真机请在「设置」或调试时写入 UserDefaults：
/// - `GoFitnessDashscopeProxyBaseURL` = `http://你的Mac局域网IP:3000`（不要末尾斜杠）
/// - 若后端 `.env` 设置了 `PROXY_TOKEN`，再设 `GoFitnessDashscopeProxyToken`
enum DashScopeLocalProxy {
    private static let baseURLKey = "GoFitnessDashscopeProxyBaseURL"
    private static let tokenKey = "GoFitnessDashscopeProxyToken"

    static var chatURL: URL {
        let raw = UserDefaults.standard.string(forKey: baseURLKey)?
            .trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
        let root = raw.isEmpty ? "http://127.0.0.1:3000" : raw
        let trimmed = root.hasSuffix("/") ? String(root.dropLast()) : root
        guard let u = URL(string: "\(trimmed)/api/chat") else {
            return URL(string: "http://127.0.0.1:3000/api/chat")!
        }
        return u
    }

    static func chat(messages: [[String: String]]) async throws -> String {
        var request = URLRequest(url: chatURL)
        request.httpMethod = "POST"
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        if let token = UserDefaults.standard.string(forKey: tokenKey)?.trimmingCharacters(in: .whitespacesAndNewlines),
           !token.isEmpty {
            request.setValue(token, forHTTPHeaderField: "X-Proxy-Token")
        }
        request.httpBody = try JSONSerialization.data(withJSONObject: ["messages": messages])

        let (data, response) = try await URLSession.shared.data(for: request)
        guard let http = response as? HTTPURLResponse else {
            throw URLError(.badServerResponse)
        }

        let obj = try JSONSerialization.jsonObject(with: data) as? [String: Any]

        if let err = obj?["error"] as? String, !err.isEmpty {
            throw NSError(domain: "DashScopeProxy", code: http.statusCode, userInfo: [NSLocalizedDescriptionKey: err])
        }
        if let errDict = obj?["error"] as? [String: Any], let msg = errDict["message"] as? String, !msg.isEmpty {
            throw NSError(domain: "DashScopeProxy", code: http.statusCode, userInfo: [NSLocalizedDescriptionKey: msg])
        }

        if !(200...299).contains(http.statusCode) {
            let snippet = String(data: data, encoding: .utf8) ?? ""
            throw NSError(domain: "DashScopeProxy", code: http.statusCode, userInfo: [NSLocalizedDescriptionKey: snippet])
        }

        if let choices = obj?["choices"] as? [[String: Any]],
           let first = choices.first,
           let message = first["message"] as? [String: Any],
           let content = message["content"] as? String {
            return content
        }

        throw NSError(domain: "DashScopeProxy", code: -1, userInfo: [NSLocalizedDescriptionKey: "Unexpected response JSON"])
    }
}

// MARK: - 训练周计划（与 AI 回复中的 JSON 块同步）
// 【模块说明】从 AI 回复里解析 ```json``` 周计划、写入 AppStorage；`TrainingLogView` 展示本周安排。

private struct TrainingDayStored: Codable, Hashable {
    var name: String
    var workouts: [String]
}

private struct StoredTrainingWeek: Codable {
    /// 本周周一 00:00（本地）的时间戳
    var weekStart: TimeInterval
    var days: [TrainingDayStored]
}

private struct WeekPlanJSONPayload: Codable {
    var goFitnessWeekPlan: Bool?
    var days: [TrainingDayStored]
}

private enum TrainingWeekCalendar {
    /// 以周一为一周起始（公历 + firstWeekday = 周一）
    static func mondayStart(of date: Date) -> Date {
        var cal = Calendar(identifier: .gregorian)
        cal.firstWeekday = 2
        let comps = cal.dateComponents([.yearForWeekOfYear, .weekOfYear], from: date)
        guard let weekDate = cal.date(from: comps) else { return cal.startOfDay(for: date) }
        return cal.startOfDay(for: weekDate)
    }

    static func isSameWeekMonday(_ stored: TimeInterval, as date: Date) -> Bool {
        let d1 = Date(timeIntervalSince1970: stored)
        let mon = mondayStart(of: date)
        return Calendar.current.isDate(d1, inSameDayAs: mon)
    }
}

private enum TrainingPlanReplyParser {
    /// 从助手回复中提取 ` ```json ... ``` ` 周计划；成功则从展示文本中移除该块
    static func displayTextAndWeek(from reply: String) -> (display: String, week: StoredTrainingWeek?) {
        guard let jsonStart = reply.range(of: "```json") else {
            return (reply, nil)
        }
        let afterMarker = reply[jsonStart.upperBound...]
        guard let fenceEnd = afterMarker.range(of: "```") else {
            return (reply, nil)
        }
        let jsonString = String(afterMarker[..<fenceEnd.lowerBound])
            .trimmingCharacters(in: .whitespacesAndNewlines)
        let before = String(reply[..<jsonStart.lowerBound])
        let afterFence = String(afterMarker[fenceEnd.upperBound...])
        let display = (before + afterFence)
            .trimmingCharacters(in: .whitespacesAndNewlines)

        guard let data = jsonString.data(using: .utf8),
              let payload = try? JSONDecoder().decode(WeekPlanJSONPayload.self, from: data),
              payload.goFitnessWeekPlan == true,
              !payload.days.isEmpty
        else {
            return (reply, nil)
        }

        let monday = TrainingWeekCalendar.mondayStart(of: Date())
        let week = StoredTrainingWeek(weekStart: monday.timeIntervalSince1970, days: payload.days)
        return (display, week)
    }
}

private struct TrainingLogView: View {
    /// `true`：从 AI 教练 sheet 打开，显示右上角「关闭」。`false`：从「我的」导航进入，使用系统返回。
    var showDismissButton: Bool = true
    /// 导航栏标题（与训练日志同一套数据）
    var navigationTitleKey: LKey = .trainingLogNav

    @Environment(\.dismiss) private var dismiss
    @AppStorage("appLanguage") private var appLanguageRaw: String = AppLanguage.zhHans.rawValue
    @AppStorage("trainingWeekStoreV1") private var trainingWeekStoreJSON: String = ""

    private var lang: AppLanguage { AppLanguage(rawValue: appLanguageRaw) ?? .zhHans }

    private var storedWeek: StoredTrainingWeek? {
        guard !trainingWeekStoreJSON.isEmpty,
              let data = trainingWeekStoreJSON.data(using: .utf8),
              let w = try? JSONDecoder().decode(StoredTrainingWeek.self, from: data)
        else { return nil }
        return w
    }

    private var hasCurrentWeekPlan: Bool {
        guard let w = storedWeek else { return false }
        return TrainingWeekCalendar.isSameWeekMonday(w.weekStart, as: Date())
    }

    /// 按当前语言显示「星期一 / Monday」，不依赖 AI 存盘里的 `day.name` 语言。
    private func weekdayTitle(week: StoredTrainingWeek, dayIndex: Int) -> String {
        let monday = Date(timeIntervalSince1970: week.weekStart)
        guard dayIndex < week.days.count,
              let dayDate = Calendar.current.date(byAdding: .day, value: dayIndex, to: monday)
        else {
            return dayIndex < week.days.count ? week.days[dayIndex].name : ""
        }
        let formatter = DateFormatter()
        formatter.locale = Locale(identifier: lang == .en ? "en_US" : "zh_CN")
        formatter.dateFormat = "EEEE"
        return formatter.string(from: dayDate)
    }

    private func weekContainsCJK(_ week: StoredTrainingWeek) -> Bool {
        for day in week.days {
            if Self.stringContainsHan(day.name) { return true }
            for line in day.workouts where Self.stringContainsHan(line) { return true }
        }
        return false
    }

    private static func stringContainsHan(_ s: String) -> Bool {
        s.unicodeScalars.contains { (0x4E00...0x9FFF).contains($0.value) }
    }

    var body: some View {
        Group {
            if let week = storedWeek, hasCurrentWeekPlan {
                List {
                    Section {
                        Text(L10n.t(.trainingLogThisWeek, lang))
                            .font(.headline)
                    }
                    ForEach(Array(week.days.enumerated()), id: \.offset) { dayIndex, day in
                        Section(header: Text(weekdayTitle(week: week, dayIndex: dayIndex))
                            .font(.subheadline.weight(.semibold))
                            .foregroundColor(.orange)) {
                            if day.workouts.isEmpty {
                                Text(L10n.t(.trainingLogRest, lang))
                                    .foregroundColor(.secondary)
                            } else {
                                ForEach(Array(day.workouts.enumerated()), id: \.offset) { _, line in
                                    Text(line)
                                }
                            }
                        }
                    }
                    if lang == .en, weekContainsCJK(week) {
                        Section {
                            Text(L10n.t(.trainingLogWorkoutsLanguageNote, lang))
                                .font(.caption)
                                .foregroundColor(.secondary)
                        }
                    }
                }
            } else {
                VStack(spacing: 20) {
                    Image(systemName: "text.book.closed.fill")
                        .font(.system(size: 48))
                        .foregroundColor(Color.orange.opacity(0.85))
                    Text(L10n.t(.trainingLogEmpty, lang))
                        .font(.title3.weight(.semibold))
                    Text(L10n.t(.trainingLogEmptyHint, lang))
                        .font(.subheadline)
                        .foregroundColor(.secondary)
                        .multilineTextAlignment(.center)
                        .padding(.horizontal, 24)
                }
                .frame(maxWidth: .infinity, maxHeight: .infinity)
            }
        }
        .navigationTitle(L10n.t(navigationTitleKey, lang))
        .navigationBarTitleDisplayMode(.inline)
        .toolbar {
            if showDismissButton {
                ToolbarItem(placement: .topBarTrailing) {
                    Button(L10n.t(.close, lang)) { dismiss() }
                }
            }
        }
    }
}

