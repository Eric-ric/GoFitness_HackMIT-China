struct RegisterView: View {
    @AppStorage("appLanguage") private var appLanguageRaw: String = AppLanguage.zhHans.rawValue
    @AppStorage("isSignedIn") private var isSignedIn: Bool = false
    @AppStorage("userDisplayName") private var userDisplayName: String = ""

    @Environment(\.dismiss) private var dismiss

    @State private var identifier: String = ""
    @State private var password: String = ""
    @State private var confirmPassword: String = ""
    @State private var errorMessage: String?

    private var lang: AppLanguage { AppLanguage(rawValue: appLanguageRaw) ?? .zhHans }

    var body: some View {
        ScrollView {
            VStack(spacing: 16) {
                VStack(spacing: 6) {
                    Text(L10n.t(.registerTitle, lang))
                        .font(.largeTitle.bold())
                    Text(L10n.t(.registerSubtitle, lang))
                        .font(.subheadline)
                        .foregroundColor(.secondary)
                }
                .padding(.top, 8)
                .padding(.bottom, 8)

                VStack(spacing: 12) {
                    TextField(
                        "",
                        text: $identifier,
                        prompt: Text(L10n.t(.phoneOrEmail, lang)).foregroundColor(.secondary)
                    )
                    .textContentType(.username)
                    .autocorrectionDisabled()
                    .padding(12)
                    .frame(maxWidth: .infinity, alignment: .leading)
                    .background(Color.secondary.opacity(0.08), in: RoundedRectangle(cornerRadius: 12, style: .continuous))
#if os(iOS)
                    .textInputAutocapitalization(.never)
                    .keyboardType(.emailAddress)
#endif

                    // 仅主密码用 .newPassword；确认框若也用 .newPassword，系统会把两框当成同一组导致内容被同步。
                    SecureField(
                        "",
                        text: $password,
                        prompt: Text(L10n.t(.passwordMin, lang)).foregroundColor(.secondary)
                    )
                    .textContentType(.newPassword)
                    .padding(12)
                    .frame(maxWidth: .infinity, alignment: .leading)
                    .background(Color.secondary.opacity(0.08), in: RoundedRectangle(cornerRadius: 12, style: .continuous))
                    .id("registerPasswordField")

                    SecureField(
                        "",
                        text: $confirmPassword,
                        prompt: Text(L10n.t(.confirmPassword, lang)).foregroundColor(.secondary)
                    )
                    .textContentType(.password)
                    .padding(12)
                    .frame(maxWidth: .infinity, alignment: .leading)
                    .background(Color.secondary.opacity(0.08), in: RoundedRectangle(cornerRadius: 12, style: .continuous))
                    .id("registerConfirmPasswordField")
                }

            if let errorMessage {
                Text(errorMessage)
                    .font(.footnote)
                    .foregroundColor(.red)
                    .frame(maxWidth: .infinity, alignment: .leading)
            }

            Button {
                errorMessage = nil
                let trimmed = identifier.trimmingCharacters(in: .whitespacesAndNewlines)
                if trimmed.isEmpty || password.isEmpty || confirmPassword.isEmpty {
                    errorMessage = L10n.t(.fillAllFields, lang)
                    return
                }
                if password.count < 6 {
                    errorMessage = L10n.t(.pwAtLeast6, lang)
                    return
                }
                if password != confirmPassword {
                    errorMessage = L10n.t(.pwMismatch, lang)
                    return
                }

                userDisplayName = trimmed
                isSignedIn = true
                dismiss()
            } label: {
                Text(L10n.t(.createAndSignIn, lang))
                    .frame(maxWidth: .infinity)
                    .padding(.vertical, 12)
            }
            .buttonStyle(.borderedProminent)
            .tint(.orange)

                Spacer(minLength: 24)
            }
            .padding(20)
        }
        .scrollDismissesKeyboard(.interactively)
    }
}

