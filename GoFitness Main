/// 成就页：展示总积分、可勾选目标、打开积分商城。
struct AchievementsView: View {
    @AppStorage("appLanguage") private var appLanguageRaw: String = AppLanguage.zhHans.rawValue
    @AppStorage("userPoints") private var userPoints: Int = 0
    /// 已完成并领取过积分的任务 id（与 `Goal.id` 一致），防止重复勾选刷分。
    @AppStorage("completedAchievementGoalIds") private var completedGoalIdsRaw: String = ""

    /// 全部任务定义（稳定 id，用于持久化「已完成」）。
    private static let allGoals: [Goal] = [
        Goal(id: "goal_train_3", titleKey: .goalTitleTrain3, points: 50),
        Goal(id: "goal_walk_8000", titleKey: .goalTitleWalk8000, points: 20),
        Goal(id: "goal_sleep_early_3", titleKey: .goalTitleSleepEarly3, points: 30)
    ]

    @State private var showPointsShop = false // 是否弹出积分商城 sheet
    /// 正在播放完成动画的任务 id；动画结束后再写入完成状态使行消失。
    @State private var completingGoalId: String?

    private var lang: AppLanguage { AppLanguage(rawValue: appLanguageRaw) ?? .zhHans }

    private var completedGoalIds: Set<String> {
        Set(completedGoalIdsRaw.split(separator: ",").map(String.init).filter { !$0.isEmpty })
    }

    /// 尚未领取积分的任务（完成后从列表移除，不可再次操作）。
    private var pendingGoals: [Goal] {
        Self.allGoals.filter { !completedGoalIds.contains($0.id) }
    }

    var body: some View {
        NavigationStack {
            List {
                Section {
                    HStack {
                        VStack(alignment: .leading, spacing: 6) {
                            Text(L10n.t(.achievementsTitle, lang)) // 页内大标题
                                .font(.title2.bold())
                            Text(L10n.t(.achievementsDesc, lang)) // 说明文字
                                .font(.subheadline)
                                .foregroundColor(.secondary)
                                .multilineTextAlignment(.leading)
                        }
                        Spacer()
                        VStack {
                            Text("\(userPoints)") // 右上角积分数字
                                .font(.system(size: 28, weight: .bold))
                            Text(L10n.t(.pointsUnitBadge, lang)) // 单位：分 / PTS
                                .font(.caption2)
                                .foregroundColor(.secondary)
                        }
                        .padding(8)
                        .background(Color.orange.opacity(0.1), in: RoundedRectangle(cornerRadius: 12, style: .continuous))
                    }
                    .padding(.vertical, 4)
                }

                Section(header: Text(L10n.t(.myGoalsSection, lang))) { // 「我的目标」分组标题
                    if pendingGoals.isEmpty {
                        Text(L10n.t(.achievementsNoPendingGoals, lang))
                            .font(.subheadline)
                            .foregroundColor(.secondary)
                    }
                    ForEach(pendingGoals) { goal in
                        Button {
                            beginGoalCompletionAnimation(for: goal)
                        } label: {
                            HStack(spacing: 12) {
                                VStack(alignment: .leading, spacing: 4) {
                                    Text(L10n.t(goal.titleKey, lang)) // 目标标题（多语言）
                                    Text(String(format: L10n.t(.goalRewardPointsFormat, lang), goal.points)) // 如「+50 分」「+50 pts」
                                        .font(.caption)
                                        .foregroundColor(.secondary)
                                }
                                Spacer(minLength: 8)
                                ZStack {
                                    if completingGoalId == goal.id {
                                        AchievementGoalCompleteCheckmark()
                                    } else {
                                        Image(systemName: "circle")
                                            .font(.title3)
                                            .foregroundColor(.secondary)
                                    }
                                }
                                .frame(width: 44, height: 44)
                            }
                            .padding(.vertical, 2)
                            .background {
                                if completingGoalId == goal.id {
                                    RoundedRectangle(cornerRadius: 12, style: .continuous)
                                        .fill(Color.green.opacity(0.12))
                                }
                            }
                        }
                        .buttonStyle(.plain)
                        .disabled(completingGoalId != nil)
                    }
                }
            }
            .navigationTitle(L10n.t(.achievementsNav, lang)) // 导航栏标题「成就」
            .toolbar {
                ToolbarItem(placement: .topBarTrailing) {
                    Button {
                        showPointsShop = true // 打开商城 sheet
                    } label: {
                        Image(systemName: "cart.fill")
                            .symbolRenderingMode(.hierarchical)
                    }
                    .tint(.orange)
                    .accessibilityLabel(L10n.t(.shopSection, lang))
                }
            }
            .sheet(isPresented: $showPointsShop) {
                NavigationStack {
                    PointsShopView() // 半屏/全屏展示商城
                }
            }
        }
    }

    /// 先播绿色对勾动画，再落库并移除行。
    private func beginGoalCompletionAnimation(for goal: Goal) {
        guard completingGoalId == nil, !completedGoalIds.contains(goal.id) else { return }
        completingGoalId = goal.id
        Task { @MainActor in
            try? await Task.sleep(for: .milliseconds(680))
            completeGoal(goal)
            if completingGoalId == goal.id {
                completingGoalId = nil
            }
        }
    }

    /// 标记完成：加积分一次，并持久化 id，列表中不再显示该任务。
    private func completeGoal(_ goal: Goal) {
        guard !completedGoalIds.contains(goal.id) else { return }
        userPoints += goal.points
        var set = completedGoalIds
        set.insert(goal.id)
        completedGoalIdsRaw = set.sorted().joined(separator: ",")
    }
}

