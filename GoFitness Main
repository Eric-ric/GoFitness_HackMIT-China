// MARK: - 我发布的（与社区「我的」共用 feed.myPublishedPosts）
// 【模块说明】仅展示当前用户发布过的帖子列表（数据来自 `CommunityFeedModel`）。

struct MyPostsView: View {
    @EnvironmentObject private var feed: CommunityFeedModel
    @AppStorage("appLanguage") private var appLanguageRaw: String = AppLanguage.zhHans.rawValue
    @AppStorage("isSignedIn") private var isSignedIn: Bool = false
    @AppStorage("userDisplayName") private var userDisplayName: String = ""

    private var lang: AppLanguage { AppLanguage(rawValue: appLanguageRaw) ?? .zhHans }

    private var currentAuthorLabel: String {
        if isSignedIn, !userDisplayName.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
            return userDisplayName.trimmingCharacters(in: .whitespacesAndNewlines)
        }
        return L10n.t(.guest, lang)
    }

    var body: some View {
        Group {
            if feed.myPublishedPosts.isEmpty {
                VStack(spacing: 16) {
                    Text(L10n.t(.myPosts, lang))
                        .font(.title2)
                        .padding(.top)
                    Text(L10n.t(.myPostsDesc, lang))
                        .font(.subheadline)
                        .foregroundColor(.secondary)
                        .multilineTextAlignment(.center)
                        .padding(.horizontal)
                    Spacer()
                }
                .frame(maxWidth: .infinity, maxHeight: .infinity)
            } else {
                List {
                    Section {
                        ForEach(feed.myPublishedPosts) { post in
                            let postId = post.id
                            CommunityPostListRow(
                                post: Binding(
                                    get: { feed.myPublishedPosts.first(where: { $0.id == postId }) ?? post },
                                    set: { new in
                                        guard let i = feed.myPublishedPosts.firstIndex(where: { $0.id == postId }) else { return }
                                        var list = feed.myPublishedPosts
                                        list[i] = new
                                        feed.myPublishedPosts = list
                                    }
                                ),
                                currentUserLabel: currentAuthorLabel
                            )
                        }
                    } footer: {
                        Text(L10n.t(.communityMyFeedFooter, lang))
                    }
                }
            }
        }
        .navigationTitle(L10n.t(.myPosts, lang))
    }
}

