    private func messagesForAPI() -> [[String: String]] {
        let planSyncRule: String = {
            switch lang {
            case .zhHans:
                return """
                当你为用户输出「一整周」（周一至周日）的训练安排时：先用自然语言把计划说清楚；然后在正文最后**另起一段**，**仅追加**一个 markdown 代码块，第一行必须是三个反引号+json，最后一行是三个反引号。代码块内必须是合法 JSON，且包含字段 goFitnessWeekPlan=true，以及 days 数组。
                days 必须恰好 7 个对象，按周一到周日顺序；每个对象：name 为该日名称（如「周一」），workouts 为字符串数组（当日训练项目，每条一行语义；休息日则用空数组 []）。
                若本次回复不是「一周七天」的训练计划，则**不要**附加该 json 代码块。
                """
            case .en:
                return """
                When you output a full Monday-through-Sunday weekly training plan: explain it in natural language first, then append **only one** markdown fenced code block marked as json at the very end. Inside, valid JSON with goFitnessWeekPlan=true and a days array.
                days must contain exactly 7 objects in Mon→Sun order; each has name (e.g. \"Monday\") and workouts (array of strings; rest days use []).
                **All strings in the JSON** (days[].name and every workouts[] line) **must be English**, even if the user previously used another language.
                If this reply is not a full weekly plan, do **not** include this json block.
                """
            }
        }()

        let systemContent = """
        You are GoFitness, a concise fitness and nutrition coach. Reply in the same language as the user when possible.

        \(planSyncRule)
        """

        var m: [[String: String]] = [
            ["role": "system", "content": systemContent]
        ]
        for b in bubbles {
            m.append(["role": b.role, "content": b.text])
        }
        return m
    }

    private func persistTrainingWeek(_ week: StoredTrainingWeek) {
        guard let data = try? JSONEncoder().encode(week),
              let str = String(data: data, encoding: .utf8) else { return }
        trainingWeekStoreJSON = str
    }

    @MainActor
    private func sendMessage() async {
        let trimmed = inputText.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !trimmed.isEmpty else { return }

        // 本地防刷：AI 发送冷却
        let now = Date()
        if let last = lastAiSendAt,
           now.timeIntervalSince(last) < 2.0 {
            errorText = "发送过快，请稍后再试"
            return
        }

        // 本地拦截：明显不良/联系方式/链接等（示例规则）
        if let reason = ContentSafety.rejectionReason(for: trimmed) {
            errorText = reason
            return
        }

        lastAiSendAt = now

        errorText = nil
        inputText = ""
        bubbles.append(AIChatBubble(role: "user", text: trimmed))
        isLoading = true

        do {
            let reply = try await DashScopeLocalProxy.chat(messages: messagesForAPI())
            let parsed = TrainingPlanReplyParser.displayTextAndWeek(from: reply)
            bubbles.append(AIChatBubble(role: "assistant", text: parsed.display))
            if let week = parsed.week {
                persistTrainingWeek(week)
            }
        } catch {
            errorText = Self.formatAIProxyError(error, lang: lang)
        }

        isLoading = false
    }

    /// 连接类错误时附带模拟器 / 真机下的代理排查说明（`Could not connect to the server` 等）。
    private static func formatAIProxyError(_ error: Error, lang: AppLanguage) -> String {
        let detail = error.localizedDescription
        let base = L10n.t(.aiErrorGeneric, lang) + "\n" + detail

        let urlCode: URLError.Code? = {
            if let u = error as? URLError { return u.code }
            let ns = error as NSError
            if let u = ns.userInfo[NSUnderlyingErrorKey] as? URLError { return u.code }
            if ns.domain == NSURLErrorDomain {
                return URLError.Code(rawValue: ns.code)
            }
            return nil
        }()

        let connectionLike: Set<URLError.Code> = [
            .cannotConnectToHost, .cannotFindHost, .timedOut, .networkConnectionLost,
            .notConnectedToInternet, .dnsLookupFailed
        ]
        guard let code = urlCode, connectionLike.contains(code) else {
            return base
        }

        #if targetEnvironment(simulator)
        return base + "\n\n" + L10n.t(.aiErrorProxyHintSimulator, lang)
        #else
        return base + "\n\n" + L10n.t(.aiErrorProxyHintDevice, lang)
        #endif
    }
}

