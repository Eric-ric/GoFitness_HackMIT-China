/// 积分商城（从成就页右上角购物车打开）。
private struct PointsShopView: View {
    @Environment(\.dismiss) private var dismiss // 用于关闭当前 sheet
    @AppStorage("appLanguage") private var appLanguageRaw: String = AppLanguage.zhHans.rawValue // 当前界面语言
    @AppStorage("userPoints") private var userPoints: Int = 0 // 用户剩余积分（与成就页共用）
    @AppStorage("redeemedShopItemIds") private var redeemedShopIdsRaw: String = "" // 已兑换商品 id，逗号分隔

    @State private var showShopAlert = false // 是否显示提示弹窗
    @State private var shopAlertText = "" // 弹窗正文

    /// 静态商品列表（演示数据）。
    private let shopRewards: [ShopReward] = [
        ShopReward(id: "coach_boost", titleKey: .shopRewardCoachTitle, descKey: .shopRewardCoachDesc, cost: 180),
        ShopReward(id: "theme_frame", titleKey: .shopRewardThemeTitle, descKey: .shopRewardThemeDesc, cost: 120),
        ShopReward(id: "streak_badge", titleKey: .shopRewardBadgeTitle, descKey: .shopRewardBadgeDesc, cost: 90)
    ]

    private var lang: AppLanguage { AppLanguage(rawValue: appLanguageRaw) ?? .zhHans } // 解析语言枚举

    var body: some View {
        List {
            Section {
                HStack {
                    Text(L10n.t(.shopBalance, lang)) // 「当前积分」标签
                        .foregroundColor(.secondary)
                    Spacer()
                    VStack(alignment: .trailing, spacing: 2) {
                        Text("\(userPoints)") // 大号数字：当前积分
                            .font(.system(size: 28, weight: .bold))
                        Text(L10n.t(.pointsUnitBadge, lang)) // 单位：中文「分」/ 英文「PTS」
                            .font(.caption2)
                            .foregroundColor(.secondary)
                    }
                    .padding(8)
                    .background(Color.orange.opacity(0.1), in: RoundedRectangle(cornerRadius: 12, style: .continuous)) // 浅橙底卡片
                }
                .padding(.vertical, 4)
            }

            Section {
                ForEach(shopRewards) { reward in // 遍历每个商品
                    VStack(alignment: .leading, spacing: 8) {
                        HStack(alignment: .top) {
                            VStack(alignment: .leading, spacing: 4) {
                                Text(L10n.t(reward.titleKey, lang)) // 商品名（多语言）
                                    .font(.headline)
                                Text(L10n.t(reward.descKey, lang)) // 商品说明
                                    .font(.caption)
                                    .foregroundColor(.secondary)
                            }
                            Spacer(minLength: 8)
                            Text(String(format: L10n.t(.shopPointsFormat, lang), reward.cost)) // 价格：如「180 积分」/「180 pts」
                                .font(.subheadline.weight(.semibold))
                                .foregroundColor(.orange)
                        }

                        if shopItemRedeemed(reward.id) { // 若已兑换过
                            Text(L10n.t(.shopRedeemed, lang))
                                .font(.caption.weight(.semibold))
                                .foregroundColor(.green)
                        } else {
                            Button {
                                redeem(reward) // 扣积分并记录兑换
                            } label: {
                                Text(L10n.t(.shopRedeem, lang))
                                    .frame(maxWidth: .infinity)
                            }
                            .buttonStyle(.borderedProminent)
                            .tint(.orange)
                            .disabled(userPoints < reward.cost) // 积分不足则禁用
                            .opacity(userPoints < reward.cost ? 0.45 : 1)
                        }
                    }
                    .padding(.vertical, 4)
                }
            }
        }
        .navigationTitle(L10n.t(.shopSection, lang)) // 导航标题：积分商城
        .navigationBarTitleDisplayMode(.inline)
        .toolbar {
            ToolbarItem(placement: .topBarTrailing) {
                Button(L10n.t(.close, lang)) { dismiss() } // 关闭商城
            }
        }
        .alert(L10n.t(.shopSection, lang), isPresented: $showShopAlert) {
            Button(L10n.t(.close, lang), role: .cancel) {}
        } message: {
            Text(shopAlertText) // 如积分不足提示
        }
    }

    /// 某商品 id 是否已在本地记录为已兑换。
    private func shopItemRedeemed(_ id: String) -> Bool {
        Set(redeemedShopIdsRaw.split(separator: ",").map(String.init)).contains(id)
    }

    /// 兑换：校验积分、扣减、写入已兑换集合。
    private func redeem(_ reward: ShopReward) {
        if shopItemRedeemed(reward.id) { return }
        if userPoints < reward.cost {
            shopAlertText = L10n.t(.shopInsufficient, lang)
            showShopAlert = true
            return
        }
        userPoints -= reward.cost
        var set = Set(redeemedShopIdsRaw.split(separator: ",").map(String.init))
        set.insert(reward.id)
        redeemedShopIdsRaw = set.sorted().joined(separator: ",")
    }
}

