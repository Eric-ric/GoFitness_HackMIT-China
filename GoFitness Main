// MARK: - 本地内容安全（纯前端/本地示例用）
// 【模块说明】发帖前简单过滤链接/不当内容等，仅演示，无服务端审核。
/// 仅用于“拦截明显刷屏/不良信息”，无法替代服务端审核（纯本地场景不可能做到 100% 安全）。
private enum ContentSafety {
    static func rejectionReason(for rawText: String) -> String? {
        let text = rawText.trimmingCharacters(in: .whitespacesAndNewlines)
        if text.isEmpty { return "内容不能为空" }
        if text.count > 600 { return "内容过长，请精简后再试" }

        // 手机号：大陆 1[3-9]xxxxxxxxx
        if text.range(of: "\\b1[3-9]\\d{9}\\b", options: .regularExpression) != nil {
            return "疑似联系方式（手机号）内容被拦截"
        }

        // 邮箱
        if text.range(of: "\\b[\\w.+-]+@[\\w-]+\\.[\\w-]+\\b", options: .regularExpression) != nil {
            return "疑似邮箱内容被拦截"
        }

        // URL / 短链
        if text.range(of: "(https?://|www\\.)\\S+", options: .regularExpression) != nil {
            return "疑似链接内容被拦截"
        }

        // 常见不良/刷屏关键词（可继续扩充）
        let bannedKeywords: [String] = [
            "赌博", "博彩", "诈骗", "钓鱼", "毒品", "卖淫", "色情", "淫秽", "涉黄", "裸",
            "卖号", "出售", "购买", "外挂", "刷分", "代练"
        ]
        if bannedKeywords.contains(where: { kw in
            text.range(of: kw, options: .caseInsensitive) != nil
        }) {
            return "内容可能不合适，已拦截"
        }

        return nil
    }
}

private enum FollowedUsersStore {
    static let appStorageKey = "followedUsersJSON_v1"

    static func names(from json: String) -> [String] {
        guard let data = json.data(using: .utf8),
              let decoded = try? JSONDecoder().decode([String].self, from: data) else { return [] }
        return decoded
    }

    static func json(from names: [String]) -> String {
        guard let data = try? JSONEncoder().encode(names) else { return "[]" }
        return String(data: data, encoding: .utf8) ?? "[]"
    }

    static func setFollowed(_ name: String, add: Bool, json: inout String) {
        var set = Set(names(from: json))
        if add { set.insert(name) } else { set.remove(name) }
        json = Self.json(from: Array(set).sorted())
    }

    static func isFollowing(_ name: String, json: String) -> Bool {
        names(from: json).contains(name)
    }
}

@MainActor
final class CommunityFeedModel: ObservableObject {
    private static let likedPostsStorageKey = "likedCommunityPostsJSON_v1"

    @Published var followingPosts: [CommunityPost]
    @Published var recommendPosts: [CommunityPost]
    /// 仅当前用户在「社区 → 我的」发布的动态，不出现在精选/关注/推荐
    @Published var myPublishedPosts: [CommunityPost]
    /// 用户点赞过的动态快照（持久化，与「我赞过的」同步）
    @Published private(set) var likedPosts: [CommunityPost]

    // MARK: 本地“反刷屏”状态（仅当前会话）
    // 限制 AI 发送频率等，仅内存、不持久化。
    private var myPostTimestamps: [Date] = []
    private var lastMyPostText: String = ""
    private var lastMyPostAt: Date?

    private var lastLikeToggleAtByPostID: [UUID: Date] = [:]
    private let myPostCooldownSeconds: TimeInterval = 2.0
    private let myPostMaxPerMinute: Int = 3
    private let myRepeatContentWindowSeconds: TimeInterval = 30
    private let likeToggleCooldownSeconds: TimeInterval = 0.8

    init() {
        followingPosts = [
            CommunityPost(author: "GoFitness助手", content: "今天完成了 5km 跑步，感觉状态不错！", likeCount: 12),
            CommunityPost(author: "GoFitness助手", content: "力量训练要注意动作标准，宁轻勿乱。", likeCount: 5)
        ]
        recommendPosts = [
            CommunityPost(author: "阿杰", content: "刚练完腿，分享一下今天的深蹲组数：5×5，最后一组有点吃力但动作没变形。", likeCount: 24, isLiked: false),
            CommunityPost(author: "跑步的小林", content: "晨跑打卡第 30 天，配速比上周快了 20 秒，继续堆跑量。", likeCount: 41, isLiked: true),
            CommunityPost(author: "瑜伽Mia", content: "上传了一段睡前拉伸跟练，适合久坐族，欢迎一起打卡～", likeCount: 18, isLiked: false),
            CommunityPost(author: "举铁的大熊", content: "卧推突破 80kg 做组了，记录一下。护腕一定要戴好。", likeCount: 56, isLiked: false),
            CommunityPost(author: "营养笔记Cici", content: "今日练后餐：鸡胸+糙米+西兰花，蛋白大概 35g，供大家参考。", likeCount: 33, isLiked: false)
        ]
        myPublishedPosts = []
        likedPosts = Self.loadLikedPostsFromStorage()
        reconcileLikedPostsWithFeed()
    }

    func posts(author: String) -> [CommunityPost] {
        (followingPosts + recommendPosts + myPublishedPosts)
            .filter { $0.author == author }
            .sorted { $0.createdAt > $1.createdAt }
    }

    /// 发表到「社区 → 我的」：做本地限流与内容拦截
    /// - Returns: `nil` 表示允许发布；否则返回拦截原因（由 CreatePostView 展示）
    func tryPublishMyPost(
        author: String,
        content: String,
        imageData: Data?,
        localVideoURL: URL?
    ) -> String? {
        let now = Date()
        let trimmed = content.trimmingCharacters(in: .whitespacesAndNewlines)

        // 1) 限流：冷却 + 每分钟最大次数
        myPostTimestamps.removeAll { now.timeIntervalSince($0) > 60 }
        if let last = myPostTimestamps.last, now.timeIntervalSince(last) < myPostCooldownSeconds {
            return "发布过快，请稍后再试"
        }
        if myPostTimestamps.count >= myPostMaxPerMinute {
            return "发帖太频繁，请稍后再试"
        }

        // 2) 重复内容拦截（同内容短时间内重复发布）
        if !trimmed.isEmpty,
           trimmed == lastMyPostText,
           let lastAt = lastMyPostAt,
           now.timeIntervalSince(lastAt) < myRepeatContentWindowSeconds {
            return "内容重复太频繁，已拦截"
        }

        // 3) 本地敏感内容拦截（仅示例规则；支持“仅媒体”发布）
        if !trimmed.isEmpty,
           let reason = ContentSafety.rejectionReason(for: trimmed) {
            return reason
        }

        // 4) 简单限制媒体体积（可选：不做严格也不会影响编译）
        if let data = imageData, data.count > 5 * 1024 * 1024 {
            return "图片太大，请换一张更小的"
        }
        if let url = localVideoURL {
            if let attrs = try? FileManager.default.attributesOfItem(atPath: url.path),
               let size = attrs[.size] as? NSNumber,
               size.int64Value > 25 * 1024 * 1024 {
                return "视频太大，请换一段更短的"
            }
        }

        // 5) 通过：记录时间窗并插入帖子
        myPostTimestamps.append(now)
        lastMyPostText = trimmed
        lastMyPostAt = now

        myPublishedPosts.insert(
            CommunityPost(author: author, content: trimmed, imageData: imageData, localVideoURL: localVideoURL),
            at: 0
        )
        return nil
    }

    /// 点赞切换冷却：防止短时间疯狂点击
    func canToggleLike(postId: UUID) -> Bool {
        let now = Date()
        if let last = lastLikeToggleAtByPostID[postId],
           now.timeIntervalSince(last) < likeToggleCooldownSeconds {
            return false
        }
        lastLikeToggleAtByPostID[postId] = now
        return true
    }

    /// 在社区里点赞/取消赞时调用，更新「我赞过的」列表并持久化
    func syncLikedSnapshot(_ post: CommunityPost, liked: Bool) {
        if liked {
            guard !likedPosts.contains(where: { $0.id == post.id }) else { return }
            var copy = post
            copy.isLiked = true
            likedPosts.insert(copy, at: 0)
        } else {
            likedPosts.removeAll { $0.id == post.id }
        }
        persistLikedPosts()
    }

    /// 在「我赞过的」里取消赞：从列表移除，并把各信息流里同 id 动态的点赞状态对齐
    func removeLikeEverywhere(postId: UUID) {
        likedPosts.removeAll { $0.id == postId }
        persistLikedPosts()
        unsetLikeInFeedArrays(postId: postId)
    }

    private static func loadLikedPostsFromStorage() -> [CommunityPost] {
        guard let data = UserDefaults.standard.data(forKey: likedPostsStorageKey),
              let decoded = try? JSONDecoder().decode([CommunityPost].self, from: data) else { return [] }
        return decoded.sorted { $0.createdAt > $1.createdAt }
    }

    private func persistLikedPosts() {
        guard let data = try? JSONEncoder().encode(likedPosts) else { return }
        UserDefaults.standard.set(data, forKey: Self.likedPostsStorageKey)
    }

    /// 合并本地已存「赞过」与信息流里标记为已赞的动态（含首次安装的示例数据）
    private func reconcileLikedPostsWithFeed() {
        var byId = Dictionary(uniqueKeysWithValues: likedPosts.map { ($0.id, $0) })
        for p in followingPosts + recommendPosts + myPublishedPosts where p.isLiked {
            var copy = p
            copy.isLiked = true
            byId[p.id] = copy
        }
        likedPosts = byId.values.sorted { $0.createdAt > $1.createdAt }
        persistLikedPosts()
    }

    private func unsetLikeInFeedArrays(postId: UUID) {
        func patch(_ posts: inout [CommunityPost]) {
            guard let i = posts.firstIndex(where: { $0.id == postId }) else { return }
            var p = posts[i]
            guard p.isLiked else { return }
            p.isLiked = false
            p.likeCount = max(0, p.likeCount - 1)
            posts[i] = p
        }
        patch(&followingPosts)
        patch(&recommendPosts)
        patch(&myPublishedPosts)
    }
}

